# =========================================================================
# Copie este arquivo para .env e ajuste os valores.
# Use `npm run find-chrome` para preencher o CHROME_PATH automaticamente.
# =========================================================================

# URL base das buscas do Google Maps.
GOOGLE_MAPS_URL=https://www.google.com/maps/search/

# Flags do Chromium aplicadas em todas as instancias do Puppeteer.
# Separe as flags por espaco e mantenha o valor entre as aspas.
CHROME_ARGS="--no-sandbox --disable-dev-shm-usage --disable-gpu --disable-setuid-sandbox --disable-webgl --disable-features=TranslateUI,BackgroundNetworking,Sync --start-maximized"

# Caminho do executavel do Chrome/Chromium.
# Detectado automaticamente por `npm run find-chrome`.
# CHROME_PATH=/usr/bin/google-chrome
